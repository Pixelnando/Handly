{
  "name": "handly",
  "version": "1.0.0",
  "private": true,
  "description": "Handly — plataforma de contratação de trabalhadores autônomos (FATEC Ourinhos). Node.js sem dependências.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
